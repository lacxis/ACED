# Firebase web config is PUBLIC (it identifies the project, it is not a secret).
# The ACED project config is committed in src/firebase/config.ts, so no env vars
# are required for normal builds or Netlify deploys.
#
# These overrides exist only if you ever point a build at a DIFFERENT Firebase
# project (e.g. a separate staging project). Leave them unset otherwise.
# VITE_FB_API_KEY=
# VITE_FB_AUTH_DOMAIN=
# VITE_FB_DATABASE_URL=
# VITE_FB_PROJECT_ID=
# VITE_FB_STORAGE_BUCKET=
# VITE_FB_MESSAGING_SENDER_ID=
# VITE_FB_APP_ID=

# Set to "false" to force a design-only build with no Firebase (sign-in disabled).
# VITE_FIREBASE_ENABLED=true
