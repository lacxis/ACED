# Firebase web config (public by design — safe to commit as .env.example, but keep real values in .env)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=
# When false (or config missing), the app runs on sample data with no network calls.
VITE_FIREBASE_ENABLED=false
